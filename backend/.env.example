# =============================================================================
# Veilence-MX Backend Configuration
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# All secrets must be changed from defaults before running in production.

# =============================================================================
# Database
# =============================================================================
# PostgreSQL connection string. Required.
DATABASE_URL=postgres://veilence:veilence_dev@localhost:5432/veilence_mx?sslmode=disable

# =============================================================================
# Redis (Job Queue)
# =============================================================================
# Redis connection URL for the async job queue.
REDIS_URL=redis://localhost:6379/0
# Maximum number of retries for failed jobs before moving to dead letter queue.
QUEUE_MAX_RETRIES=5
# Maximum time a job can be locked (processing) before it's considered stuck.
QUEUE_LOCK_TIMEOUT=10m

# =============================================================================
# LLM Analysis
# =============================================================================
# Base URL for the Copilot API proxy (LLM analysis backend).
COPILOT_API_URL=http://localhost:4141
# Model to use for analysis.
COPILOT_MODEL=claude-sonnet-4.6

# =============================================================================
# Polling Configuration
# =============================================================================
# How often to check for new package releases.
PYPI_POLL_INTERVAL=5m
NPM_POLL_INTERVAL=5m
# Number of top packages to monitor per registry.
PYPI_TOP_N=100
NPM_TOP_N=100
# How often to refresh the top-N package list.
TOP_N_REFRESH_INTERVAL=24h
# Maximum number of concurrent package fetches.
POLLER_CONCURRENCY=5

# =============================================================================
# Analysis Configuration
# =============================================================================
# Maximum diff size (bytes) to send for LLM analysis.
DIFF_SIZE_LIMIT=102400
# Version depth mode: "latest" (only latest version) or "count" (N most recent).
VERSION_DEPTH_MODE=latest
# Number of versions to analyze when VERSION_DEPTH_MODE=count.
VERSION_DEPTH_COUNT=3

# =============================================================================
# Server
# =============================================================================
# Port the HTTP server listens on.
SERVER_PORT=8080
# Frontend URL for CORS and CSP configuration.
FRONTEND_URL=http://localhost:3000
# Application environment: "development" or "production".
# In development mode, some security defaults are relaxed.
APP_ENV=development

# =============================================================================
# Authentication & Secrets
# =============================================================================
# REQUIRED in production. Must be at least 32 characters of random data.
# Generate with: openssl rand -hex 32
# In development (APP_ENV=development), a default value is used if not set.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# Previous JWT secrets for rotation support (comma-separated).
# When rotating JWT_SECRET, move the old secret here so existing tokens
# remain valid until they expire. Remove after AccessTokenDuration (15min).
# Example: JWT_SECRET_PREVIOUS=old-secret-1,old-secret-2
JWT_SECRET_PREVIOUS=

# =============================================================================
# Email / SMTP
# =============================================================================
# SMTP server for sending emails (password resets, verification, notifications).
# Leave blank to disable email sending (tokens will be logged to console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Use TLS when connecting to the SMTP server.
SMTP_USE_TLS=true
